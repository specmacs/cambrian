# Copy to .env and fill in. Everything here is read by cambrian/config.py.
# Leaving a value blank makes the relevant desk fail closed — that is the
# intended safe default, not a bug.

# --- Chain access ---
# RPC endpoint for Robinhood Chain (chain 4663). The public endpoint below works
# out of the box (rate-limited — use a dedicated provider for production). Without
# it there is no chain access at all.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Wallets (capital segregation) ---
# Two DIFFERENT addresses. The system refuses to run if they are equal. Each
# desk only ever holds its own key; no code path moves funds between them.
DEGEN_WALLET=
LP_WALLET=

# --- Safety ---
# DRY_RUN is TRUE unless this is exactly the string "false" (case-insensitive).
# Leave it alone until you have watched the journal for weeks. Even with it off,
# live execution is currently unimplemented and will refuse to broadcast.
DRY_RUN=true

# Where the append-only order journal is written.
ORDER_JOURNAL=journal.jsonl

# --- Data feed ---
# Cambrian API key (financial-intelligence API — pool TVL / fee-APR for the LP
# desk). From your Cambrian dashboard. Override the base URL if docs differ.
CAMBRIAN_API_KEY=
CAMBRIAN_BASE_URL=https://api.cambrian.org
