  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.26.0",
    "@openzeppelin/contracts": "^5.4.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "viem": "^2.21.0"
  }
}
