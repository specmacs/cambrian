{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "./hardhat.config.ts",
    "./script/**/*.ts",
    "./test/**/*.ts",
    "./bot/**/*.ts",
    "./config/**/*.ts",
    "./typechain-types/**/*.ts"
  ]
}
